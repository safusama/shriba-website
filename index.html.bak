  </script>
  <script>
  // Simple scroll fade-in
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  });

  const hiddenElements = document.querySelectorAll('.section, .cinematic-split, .slider-container');
  hiddenElements.forEach((el) => el.classList.add('hidden'));
  hiddenElements.forEach((el) => observer.observe(el));

  document.querySelectorAll('.slider-control').forEach((button) => {
    button.addEventListener('click', () => {
      const track = document.getElementById(button.getAttribute('aria-controls'));
      const direction = button.dataset.direction === 'next' ? 1 : -1;
      track.scrollBy({ left: direction * track.clientWidth * 0.8, behavior: 'smooth' });
    });
  });
</script>
  <script>
    // --- Scroll Logo Animation ---
    const logo = document.getElementById('main-logo');
    const header = document.getElementById('site-header');

    const updateScrollHeader = () => {
      if (window.scrollY > 100) {
        logo.classList.add('scrolled');
        header.classList.add('scrolled-header');
      } else {
        logo.classList.remove('scrolled');
        header.classList.remove('scrolled-header');
      }
    };

    window.addEventListener('scroll', updateScrollHeader, { passive: true });
    updateScrollHeader();
  </script>
  <script>
    // --- Apple-style Timeline Slider ---
    (function() {
      var track = document.getElementById('apple-track');
      var btnPrev = document.getElementById('apple-btn-prev');
      var btnNext = document.getElementById('apple-btn-next');
      if (!track) return;

      function getStep() {
        var card = track.querySelector('.apple-card');
        if (!card) return 300;
        var gap = parseInt(window.getComputedStyle(track).gap) || 24;
        return card.offsetWidth + gap;
      }

      btnNext && btnNext.addEventListener('click', function() {
        track.scrollBy({ left: getStep(), behavior: 'smooth' });
      });
      btnPrev && btnPrev.addEventListener('click', function() {
        track.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });

      // Touch/drag support
      var startX = 0, startScroll = 0, dragging = false;
      track.addEventListener('mousedown', function(e) {
        dragging = true; startX = e.pageX; startScroll = track.scrollLeft;
        track.style.cursor = 'grabbing';
      });
      window.addEventListener('mouseup', function() {
        dragging = false; track.style.cursor = 'grab';
      });
      track.addEventListener('mousemove', function(e) {
        if (!dragging) return;
        e.preventDefault();
        track.scrollLeft = startScroll - (e.pageX - startX);
      });
    })();
  </script>
</body>
</html>
